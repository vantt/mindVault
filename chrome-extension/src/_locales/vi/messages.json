  "hintPositionHash": {
    "message": "<span class='tip-pos'>#</span> Prefix — <span class='tip-secret'>secret</span> + <span class='tip-hash'>hash</span><br>vd: <span class='tip-secret'>XYZ</span> + <span class='tip-hash'>abc</span> → <span class='tip-secret'>XYZ</span><span class='tip-hash'>abc</span>"
  },
  "hintPositionDollar": {
    "message": "<span class='tip-pos'>$$</span> Suffix — <span class='tip-hash'>hash</span> + <span class='tip-secret'>secret</span><br>vd: <span class='tip-hash'>abc</span> + <span class='tip-secret'>XYZ</span> → <span class='tip-hash'>abc</span><span class='tip-secret'>XYZ</span>"
  },
  "hintPositionAt": {
    "message": "<span class='tip-pos'>@</span> Middle — chèn <span class='tip-secret'>secret</span> vào giữa <span class='tip-hash'>hash</span><br>vd: <span class='tip-hash'>a</span><span class='tip-secret'>XYZ</span><span class='tip-hash'>bc</span>"
  },
  "hintPositionPercent": {
    "message": "<span class='tip-pos'>%</span> Interleave 1 — trộn từng ký tự<br>vd: <span class='tip-hash'>a</span><span class='tip-secret'>X</span><span class='tip-hash'>b</span><span class='tip-secret'>Y</span><span class='tip-hash'>c</span><span class='tip-secret'>Z</span>"
  },
  "hintPositionCaret": {
    "message": "<span class='tip-pos'>^</span> Interleave 2 — trộn từng 2 ký tự<br>vd: <span class='tip-hash'>ab</span><span class='tip-secret'>XY</span><span class='tip-hash'>c</span><span class='tip-secret'>Z</span>"
  },
  "hintModifierFlip": {
    "message": "<span class='tip-mod'>_</span> Lật <span class='tip-pos'>#</span>↔<span class='tip-pos'>$$</span> (không ảnh hưởng <span class='tip-pos'>@ % ^</span>). 1 cặp hash+secret → 2 password."
  },
  "hintModifierUpper": {
    "message": "<span class='tip-mod'>!</span> Viết hoa <span class='tip-secret'>secret</span> trước khi ghép"
