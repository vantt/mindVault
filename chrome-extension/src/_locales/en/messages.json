  "errHashAscii": {
    "message": "Only ASCII letters and digits (a-z, A-Z, 0-9). Unicode is unreliable across devices."
  },
  "hintPositionHash": {
    "message": "<span class='tip-pos'>#</span> Prefix — <span class='tip-secret'>secret</span> + <span class='tip-hash'>hash</span><br>e.g. <span class='tip-secret'>XYZ</span> + <span class='tip-hash'>abc</span> → <span class='tip-secret'>XYZ</span><span class='tip-hash'>abc</span>"
  },
  "hintPositionDollar": {
    "message": "<span class='tip-pos'>$$</span> Suffix — <span class='tip-hash'>hash</span> + <span class='tip-secret'>secret</span><br>e.g. <span class='tip-hash'>abc</span> + <span class='tip-secret'>XYZ</span> → <span class='tip-hash'>abc</span><span class='tip-secret'>XYZ</span>"
  },
  "hintPositionAt": {
    "message": "<span class='tip-pos'>@</span> Middle — insert <span class='tip-secret'>secret</span> into the middle of <span class='tip-hash'>hash</span><br>e.g. <span class='tip-hash'>a</span><span class='tip-secret'>XYZ</span><span class='tip-hash'>bc</span>"
  },
  "hintPositionPercent": {
    "message": "<span class='tip-pos'>%</span> Interleave 1-by-1 — alternate one char from each<br>e.g. <span class='tip-hash'>a</span><span class='tip-secret'>X</span><span class='tip-hash'>b</span><span class='tip-secret'>Y</span><span class='tip-hash'>c</span><span class='tip-secret'>Z</span>"
  },
  "hintPositionCaret": {
    "message": "<span class='tip-pos'>^</span> Interleave 2-by-2 — alternate two chars from each<br>e.g. <span class='tip-hash'>ab</span><span class='tip-secret'>XY</span><span class='tip-hash'>c</span><span class='tip-secret'>Z</span>"
  },
  "hintModifierFlip": {
    "message": "<span class='tip-mod'>_</span> Flip position <span class='tip-pos'>#</span>↔<span class='tip-pos'>$$</span> (no effect on <span class='tip-pos'>@ % ^</span>). One hash+secret pair → two passwords."
  },
  "hintModifierUpper": {
    "message": "<span class='tip-mod'>!</span> Uppercase the <span class='tip-secret'>secret</span> before combining"
  },
  "hintModifierReverse": {
    "message": "<span class='tip-mod'>?</span> Reverse the <span class='tip-secret'>secret</span> string before combining"
  },
  "hintModifierStrip": {
    "message": "<span class='tip-mod'>~</span> Strip non-alphanumeric chars from <span class='tip-secret'>secret</span>"
  },
